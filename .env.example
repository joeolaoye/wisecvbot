# ── WiseCV configuration ─────────────────────────────────────────────
# Copy to .env, fill in, then: docker compose up (or npm run dev)
# The app refuses to boot on missing/invalid values — fail loud, never default-open.

# Postgres (compose provides this; self-hosters point at their own)
DATABASE_URL=postgres://wisecv:wisecv@localhost:5432/wisecv

# HTTP
APP_PORT=3000
# Public HTTPS URL of this instance — required for the Telegram webhook (bot mode).
# If unset, the bot runs in long-polling mode instead (dev-friendly).
# APP_URL=https://wisecv.example.com

# Telegram (BotFather token; required for bot/match-delivery mode)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# REQUIRED when APP_URL is set (webhook mode) — shared secret Telegram sends
# with every webhook call (openssl rand -hex 32). Boot fails without it.
# TELEGRAM_WEBHOOK_SECRET=change-me
# Webhook path segment (default telegram/webhook)
TELEGRAM_WEBHOOK_PATH=telegram/webhook

# CV encryption key — 32 bytes, base64. Generate: openssl rand -base64 32
CV_ENCRYPTION_KEY=

# LLM providers — chat runs on LLM_PROVIDER; embeddings ALWAYS use the
# OpenAI-compatible provider (Anthropic has no embeddings API).
# LLM_PROVIDER=openai            # openai | anthropic
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible endpoint override (Ollama for fully-local)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Overrides the provider's default chat model when set
# CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Hard daily stop for all LLM spend (US cents). Calls are skipped past this, not alerted.
DAILY_LLM_BUDGET_CENTS=500
# Cost estimate for budget accounting (cents per 1k tokens). Default 1 over-estimates
# gpt-4o-mini ~20x (safe side); set 0.2 for tighter accounting.
LLM_CENTS_PER_1K_TOKENS=1

# Matching
MAX_MATCH_ALERTS_PER_DAY=3

# Scheduler crons (match deliberately offset from the hour)
INGEST_CRON=0 * * * *
MATCH_CRON=30 9 * * *

# Aggregators (optional — leave unset to skip)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

LOG_LEVEL=info
