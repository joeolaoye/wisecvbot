{
  "name": "wisecv",
  "version": "0.1.0",
  "description": "Open-source AI job-match agent: monitors tech job boards, matches them to subscriber profiles, and delivers fit-reviewed alerts via Telegram (WhatsApp v2).",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "ingest:once": "tsx src/cli/ingest.ts",
    "match:once": "tsx src/cli/match.ts",
    "llm:check": "tsx src/cli/llm-check.ts",
    "boards:check": "tsx scripts/smoke-boards.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/openai": "^4.0.93",
    "ai": "^7.0.140",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "posthog-node": "^5.21.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
